        /* Tampilan Layar Laptop & Desktop */
        @media (min-width: 992px) {
            .hero-header {
                padding: 60px 0 50px 0;
            }
            .floating-card-desktop {
                margin-top: -45px;
            }
            .bottom-nav {
                display: none !important;
            }
            .page-wrapper {
                padding-bottom: 0px;
            }
            .hero-logo-img {
                width: 130px;
                height: 130px;
            }
        }

        /* Tampilan Layar Smartphone (Mobile App Look) */
        @media (max-width: 991.98px) {
            .hero-header {
                padding: 35px 0 30px 0;
                border-bottom-left-radius: 20px;
                border-bottom-right-radius: 20px;
            }
            .floating-card-desktop {
                margin-top: -25px;
            }
            .page-wrapper {
                padding-bottom: 85px;
            }
            .hero-logo-img {
                width: 95px;
                height: 95px;
            }
        }

        .hero-header {
            background: linear-gradient(135deg, #0d6efd 0%, #004fb8 100%);
            color: white;
        }

        /* Logo Brand Bulat */
        .brand-logo-nav {
            width: 38px;
            height: 38px;
            object-fit: contain;
            background: white;
            border-radius: 50%;
            padding: 2px;
        }

        /* Stepper Visual Pelacakan */
        .stepper-wrapper {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 25px 0 15px 0;
        }
        .stepper-wrapper::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 5%;
            right: 5%;
            height: 3px;
            background: #e9ecef;
            z-index: 1;
        }
        .step-point {
            position: relative;
            z-index: 2;
            text-align: center;
            background: white;
            padding: 0 6px;
        }
        .step-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 6px auto;
            font-size: 1.1rem;
            transition: all 0.3s;
        }
        .step-point.active .step-circle {
            background: #0d6efd;
            color: white;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.25);
        }
        .step-point.completed .step-circle {
            background: #198754;
            color: white;
        }

        /* Menu Cepat Kategori */
        .quick-icon-box {
            width: 60px;
            height: 60px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px auto;
            font-size: 1.6rem;
            transition: transform 0.2s;
        }
        .quick-icon-box:hover {
            transform: translateY(-3px);
        }

        /* Bottom Nav Bar di HP */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            border-top: 1px solid #dee2e6;
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
            z-index: 1050;
            box-shadow: 0 -3px 12px rgba(0,0,0,0.06);
        }
        .bottom-nav a {
            color: #6c757d;
            text-decoration: none;
            font-size: 0.72rem;
            text-align: center;
            font-weight: 600;
            flex: 1;
        }
        .bottom-nav a.active, .bottom-nav a:hover {
            color: #0d6efd;
        }
        .bottom-nav a i {
            font-size: 1.35rem;
            display: block;
            margin-bottom: 2px;
        }
    </style>
