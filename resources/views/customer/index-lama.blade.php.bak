<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function hitungEstimasi() {
        const select = document.getElementById('calc-service');
        const price = parseFloat(select.value) || 0;
        const selectedOption = select.options[select.selectedIndex];
        const unit = selectedOption.getAttribute('data-unit') || 'kg';
        
        document.getElementById('calc-unit-label').innerText = unit;
        
        const qty = parseFloat(document.getElementById('calc-qty').value) || 0;
        const total = price * qty;
        
        document.getElementById('calc-total').innerText = 'Rp ' + total.toLocaleString('id-ID');
    }
</script>
</body>
